# Copie para .env (local) ou cadastre na Vercel em Settings > Environment Variables.
# Nunca coloque valores reais neste arquivo.
DATABASE_URL=
# Domínio base dos subdomínios das barbearias (ex.: plataforma.com.br). Opcional na demonstração.
PLATFORM_ROOT_DOMAIN=
# Só para demonstração/preview: slug da barbearia exibida quando o host não é reconhecido.
DEFAULT_SHOP_SLUG=demo
